{
  "openapi": "3.0.3",
  "info": {
    "title": "One OCR Next API",
    "version": "0.2.0",
    "description": "Synchronous Linux native OCR with OneOCR bundled in the Docker image. Optional DeepDoc layout labels page regions and runs the same OneOCR pipeline on eligible crops. Optional preprocessing returns coordinates mapped to decoded pixels after EXIF. Optional Needle extraction converts OCR text to a schema-constrained JSON object. Table structure reconstruction is not provided."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/health/live": {
      "get": {"operationId": "liveness", "summary": "Process liveness", "responses": {"200": {"description": "Process is alive"}}}
    },
    "/health/ready": {
      "get": {"operationId": "readiness", "summary": "Model readiness and queue occupancy", "responses": {
        "200": {"description": "Models initialized; pending includes running, queued and uploading requests", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}},
        "503": {"description": "Service is closing"}
      }}
    },
    "/openapi.json": {
      "get": {"operationId": "openapi", "summary": "OpenAPI contract", "responses": {"200": {"description": "This document"}}}
    },
    "/v1/ocr": {
      "post": {
        "operationId": "recognizeImage",
        "summary": "Recognize one image",
        "description": "Also available at /api/v1/ocr, /ocr and /. Authentication is required when ONEOCR_API_KEY is configured (required by the Compose deployment). Images are processed in memory and are not persisted. Multi-page TIFF and animated GIF process the first page/frame only. Queue execution is serialized per engine. Deadlines include body upload, queue wait, recognition and optional extraction; cancellation cannot preempt an ONNX call already running. Layout, image preprocessing and post-OCR Needle JSON extraction are opt-in; omitting them preserves the existing full-image OneOCR path. Needle extraction requires multipart with one image, a schema JSON text part and optional instruction; its own timeout/unavailable/model-output statuses are returned in the HTTP 200 OCR result after OCR completes, while the overall request deadline remains HTTP 504.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"in": "query", "name": "language", "description": "Language alias or script. Use either language or script. Aliases include vi, en, zh, ja, ko, ru, ar, hi, el, th, he, ta.", "schema": {"type": "string", "default": "auto"}},
          {"in": "query", "name": "script", "description": "Alias for language", "schema": {"type": "string", "enum": ["auto", "latin", "cjk", "cyrillic", "arabic", "devanagari", "greek", "thai", "hebrew", "tamil"]}},
          {"in": "query", "name": "max_lines", "schema": {"type": "integer", "minimum": 0, "maximum": 1000, "default": 1000}},
          {"in": "query", "name": "resize_long", "schema": {"type": "integer", "minimum": 32, "maximum": 1152, "default": 1152}},
          {"in": "query", "name": "resize_short", "schema": {"type": "integer", "minimum": 32, "maximum": 768, "default": 768}},
          {"in": "query", "name": "min_confidence", "schema": {"type": "number", "minimum": 0, "maximum": 1, "default": 0}},
          {"in": "query", "name": "reject_low_quality", "schema": {"type": "boolean", "default": true}},
          {"in": "query", "name": "extract", "description": "Optional post-OCR schema-constrained extraction; currently only needle. Requires multipart image plus one schema text part; raw image requests return 422.", "schema": {"type": "string", "enum": ["needle"]}},
          {"in": "query", "name": "layout", "description": "Optional semantic page-region detection. Requires the pinned local DeepDoc ONNX model. Layout tags regions; it does not reconstruct table rows or cells.", "schema": {"type": "string", "enum": ["deepdoc"]}},
          {"in": "query", "name": "layout_threshold", "description": "Minimum DeepDoc class score; used only with layout=deepdoc.", "schema": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2}},
          {"in": "query", "name": "max_regions", "description": "Maximum layout regions retained for this request; used only with layout=deepdoc.", "schema": {"type": "integer", "minimum": 1, "maximum": 64, "default": 32}},
          {"in": "query", "name": "max_dimension", "description": "Optional maximum for the longer image edge; only downsizes and preserves aspect ratio.", "schema": {"type": "integer", "minimum": 32, "maximum": 4096}},
          {"in": "query", "name": "rotation", "description": "Optional clockwise-positive rotation in degrees. The output canvas expands and is filled white.", "schema": {"type": "number", "minimum": -180, "maximum": 180, "default": 0}},
          {"in": "query", "name": "deskew", "description": "Estimate and apply bounded small-angle deskew when a clear horizontal-text projection peak is found.", "schema": {"type": "boolean", "default": false}},
          {"in": "query", "name": "padding", "description": "Optional white border, in pixels added to each edge.", "schema": {"type": "integer", "minimum": 0, "maximum": 128, "default": 0}}
        ],
        "requestBody": {
          "required": true,
          "description": "Default maximum body 20 MiB, decoded image 40 million pixels, each dimension 2..10000. One file per request. Multipart accepts file or image, never both. When extract=needle, send exactly one schema JSON text part and at most one instruction text part; schema/instruction errors return 422 before OCR. Unknown/duplicate query parameters are rejected.",
          "content": {
            "image/png": {"schema": {"type": "string", "format": "binary"}},
            "image/jpeg": {"schema": {"type": "string", "format": "binary"}},
            "image/webp": {"schema": {"type": "string", "format": "binary"}},
            "image/tiff": {"schema": {"type": "string", "format": "binary"}},
            "image/bmp": {"schema": {"type": "string", "format": "binary"}},
            "image/gif": {"schema": {"type": "string", "format": "binary"}},
            "application/octet-stream": {"schema": {"type": "string", "format": "binary"}},
            "multipart/form-data": {"schema": {"type": "object", "properties": {"file": {"type": "string", "format": "binary"}, "image": {"type": "string", "format": "binary"}, "schema": {"type": "string", "description": "JSON Schema text for extract=needle; maximum 8 KiB UTF-8."}, "instruction": {"type": "string", "description": "Optional caller guidance; maximum 1 KiB UTF-8."}}, "additionalProperties": false}}
          }
        },
        "responses": {
          "200": {"description": "OCR result. When layout or preprocessing is enabled, OCR and layout coordinates use decoded_image_pixels_after_exif and include transform metadata. When extract=needle, preserves OCR fields and adds extraction metadata/status and data on success.", "headers": {"X-Request-ID": {"schema": {"type": "string", "format": "uuid"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OcrResult"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidOptions"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "503": {"$ref": "#/components/responses/Busy"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "description": "Configured ONEOCR_API_KEY; send Authorization: Bearer <key>"}},
    "schemas": {
      "Health": {"type": "object", "properties": {"status": {"type": "string"}, "engine": {"type": "string"}, "platform": {"type": "string"}, "model_sha256": {"type": "string"}, "semantic_layout_available": {"type": "boolean"}, "semantic_layout_provider": {"type": "string", "nullable": true}, "json_extraction_model_available": {"type": "boolean", "description": "Configured model file exists; it is not hash-verified or warmed by readiness."}, "json_extraction_provider": {"type": "string", "enum": ["cactus-needle-wasm"]}, "extraction_pending": {"type": "integer", "maximum": 1, "description": "Reserved extraction request; includes body upload, OCR and extraction, not just active model inference."}, "max_extraction_pending": {"type": "integer", "enum": [1]}, "pending": {"type": "integer"}, "max_pending": {"type": "integer"}, "version": {"type": "string"}}},
      "Error": {"type": "object", "required": ["error", "message", "request_id"], "properties": {"error": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string", "format": "uuid"}}},
      "Quadrilateral": {"type": "object", "required": ["x1", "y1", "x2", "y2", "x3", "y3", "x4", "y4"], "properties": {"x1": {"type": "number"}, "y1": {"type": "number"}, "x2": {"type": "number"}, "y2": {"type": "number"}, "x3": {"type": "number"}, "y3": {"type": "number"}, "x4": {"type": "number"}, "y4": {"type": "number"}}},
      "RegionBox": {"type": "object", "required": ["x0", "y0", "x1", "y1"], "properties": {"x0": {"type": "number"}, "y0": {"type": "number"}, "x1": {"type": "number"}, "y1": {"type": "number"}}},
      "ImageDimensions": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}},
      "AffineMatrix": {"type": "array", "description": "3×3 affine transform, row-major.", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
      "PreprocessingOperation": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "enum": ["resize", "rotation", "deskew", "white_padding"]}, "width": {"type": "integer"}, "height": {"type": "integer"}, "degrees": {"type": "number"}, "pixels": {"type": "integer"}}},
      "Preprocessing": {"type": "object", "required": ["coordinate_space", "processed_coordinate_space", "source_dimensions", "processed_dimensions", "operations", "source_to_processed", "processed_to_source"], "properties": {"coordinate_space": {"type": "string", "enum": ["decoded_image_pixels_after_exif"]}, "processed_coordinate_space": {"type": "string", "enum": ["processed_image_pixels"]}, "source_dimensions": {"$ref": "#/components/schemas/ImageDimensions"}, "processed_dimensions": {"$ref": "#/components/schemas/ImageDimensions"}, "operations": {"type": "array", "items": {"$ref": "#/components/schemas/PreprocessingOperation"}}, "source_to_processed": {"$ref": "#/components/schemas/AffineMatrix"}, "processed_to_source": {"$ref": "#/components/schemas/AffineMatrix"}}},
      "Word": {"type": "object", "required": ["text", "bounding_rect", "confidence"], "properties": {"text": {"type": "string"}, "bounding_rect": {"$ref": "#/components/schemas/Quadrilateral"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "token_confidence": {"type": "number"}}},
      "Line": {"type": "object", "required": ["text", "bounding_rect", "words"], "properties": {"text": {"type": "string"}, "bounding_rect": {"$ref": "#/components/schemas/Quadrilateral"}, "words": {"type": "array", "items": {"$ref": "#/components/schemas/Word"}}, "confidence": {"type": "number"}, "script": {"type": "string"}, "layout": {"type": "string", "enum": ["horizontal-glyphs", "vertical-glyphs"], "description": "OneOCR's glyph orientation for this OCR line, not a semantic page-region label."}, "layout_region": {"type": "object", "description": "Present for semantic-layout OCR; links this line to its DeepDoc page region.", "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "class_id": {"type": "integer"}, "score": {"type": "number"}}}, "style": {"type": "object"}, "rejection": {"type": "object"}}},
      "LayoutModel": {"type": "object", "required": ["repository", "revision", "file", "sha256", "license", "reference_implementation"], "properties": {"repository": {"type": "string", "example": "InfiniFlow/deepdoc"}, "revision": {"type": "string"}, "file": {"type": "string", "example": "layout.onnx"}, "sha256": {"type": "string"}, "license": {"type": "string", "example": "Apache-2.0"}, "reference_implementation": {"type": "string"}}},
      "LayoutOcr": {"type": "object", "nullable": true, "required": ["text", "lines", "recognition_attempts"], "properties": {"text": {"type": "string"}, "lines": {"type": "array", "items": {"$ref": "#/components/schemas/Line"}}, "recognition_attempts": {"type": "integer"}}},
      "LayoutRegion": {"type": "object", "required": ["id", "label", "class_id", "score", "bbox", "bounding_rect", "coordinate_space", "ocr", "ocr_status"], "properties": {"id": {"type": "string"}, "label": {"type": "string", "enum": ["text", "title", "figure", "figure caption", "table", "table caption", "header", "footer", "reference", "equation"]}, "class_id": {"type": "integer", "minimum": 1, "maximum": 10, "description": "Class 0 (_background_) is suppressed by this API."}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "bbox": {"$ref": "#/components/schemas/RegionBox"}, "bounding_rect": {"$ref": "#/components/schemas/Quadrilateral"}, "coordinate_space": {"type": "string", "enum": ["decoded_image_pixels_after_exif"]}, "ocr": {"$ref": "#/components/schemas/LayoutOcr"}, "ocr_status": {"type": "string", "nullable": true, "enum": ["recognized", "no_text", "non_text_region", "contained_by_table", "invalid_region_geometry", "region_pixel_limit", "total_region_pixel_limit", "line_limit", "recognition_work_limit"]}}},
      "LayoutBudget": {"type": "object", "properties": {"per_region": {"type": "integer"}, "total": {"type": "integer"}, "used": {"type": "integer"}, "exhausted": {"type": "boolean"}}},
      "LayoutResult": {"type": "object", "required": ["provider", "model", "coordinate_space", "input_size", "threshold", "detected_region_count", "candidate_count", "candidate_truncated", "regions_truncated", "regions", "region_pixel_budget", "recognition_budget"], "properties": {"provider": {"type": "string", "enum": ["deepdoc-onnx"]}, "model": {"$ref": "#/components/schemas/LayoutModel"}, "coordinate_space": {"type": "string", "enum": ["decoded_image_pixels_after_exif"]}, "input_size": {"type": "integer", "enum": [640]}, "threshold": {"type": "number", "minimum": 0, "maximum": 1}, "detected_region_count": {"type": "integer"}, "candidate_count": {"type": "integer"}, "candidate_truncated": {"type": "boolean"}, "regions_truncated": {"type": "boolean"}, "regions": {"type": "array", "items": {"$ref": "#/components/schemas/LayoutRegion"}}, "region_pixel_budget": {"$ref": "#/components/schemas/LayoutBudget"}, "recognition_budget": {"$ref": "#/components/schemas/LayoutBudget"}}},
      "NeedleModel": {"type": "object", "required": ["name", "revision", "sha256", "runtime", "runtime_version"], "properties": {"name": {"type": "string", "enum": ["needle3"]}, "revision": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "runtime": {"type": "string", "enum": ["cactus-needle"]}, "runtime_version": {"type": "string", "enum": ["0.3.0"]}}},
      "ExtractionError": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string"}}},
      "JsonExtraction": {"type": "object", "required": ["provider", "model", "schema_validation", "output_validation", "status", "elapsed_ms"], "properties": {"provider": {"type": "string", "enum": ["cactus-needle-wasm"]}, "model": {"$ref": "#/components/schemas/NeedleModel"}, "schema_validation": {"type": "string", "enum": ["valid"]}, "output_validation": {"type": "string", "enum": ["not_run", "valid", "failed", "not_produced"]}, "status": {"type": "string", "enum": ["success", "no_match", "invalid_model_output", "unavailable", "input_too_large", "timeout", "busy"]}, "error": {"$ref": "#/components/schemas/ExtractionError"}, "elapsed_ms": {"type": "integer", "minimum": 0, "description": "Whole extraction phase: schema/context checks, model hash verification, first-use runtime/worker initialization, inference and abort cleanup when applicable."}, "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input_bytes": {"type": "integer", "minimum": 0}, "context_bytes": {"type": "integer", "minimum": 0}, "max_context_bytes": {"type": "integer", "minimum": 0}, "validation_issue_count": {"type": "integer", "minimum": 0}, "data": {"type": "object", "description": "Only present on success. Shape is the caller's accepted extraction schema; extra properties are rejected."}}},
      "OcrResult": {"type": "object", "required": ["text", "text_angle", "lines", "width", "height", "elapsed_ms", "model_sha256", "provenance", "request_id"], "properties": {"text": {"type": "string"}, "text_angle": {"type": "number"}, "lines": {"type": "array", "items": {"$ref": "#/components/schemas/Line"}}, "width": {"type": "integer"}, "height": {"type": "integer"}, "elapsed_ms": {"type": "number", "description": "Includes preprocessing and OCR recognition; excludes request queue wait, image decode, HTTP body parsing and optional Needle extraction."}, "model_sha256": {"type": "string"}, "provenance": {"type": "object"}, "request_id": {"type": "string", "format": "uuid"}, "coordinate_space": {"type": "string", "enum": ["decoded_image_pixels_after_exif"], "description": "Present for preprocessing or semantic layout responses."}, "preprocessing": {"$ref": "#/components/schemas/Preprocessing"}, "layout": {"$ref": "#/components/schemas/LayoutResult"}, "extraction": {"$ref": "#/components/schemas/JsonExtraction", "description": "Present when extract=needle; OCR fields remain present for all extraction statuses."}}}
    },
    "responses": {
      "BadRequest": {"description": "Empty/invalid image or malformed multipart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Missing or invalid API key", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "TooLarge": {"description": "Body exceeds configured limit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "UnsupportedMedia": {"description": "Unsupported Content-Type", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InvalidOptions": {"description": "Invalid query/options, schema, extraction mode or image dimensions; raw image is not allowed when extract=needle", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InternalError": {"description": "Internal engine failure; use request ID for logs", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Busy": {"description": "OCR queue full, service draining or Needle extraction slot occupied", "headers": {"Retry-After": {"description": "Retry after one second", "schema": {"type": "string", "example": "1"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Timeout": {"description": "Upload, queue and recognition deadline exceeded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
