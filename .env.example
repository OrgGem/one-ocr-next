# Generate .env and a random API key with: node tools/init-service.mjs
# An actual key must have at least 32 characters. Never commit .env.
ONEOCR_API_KEY=
ONEOCR_IMAGE=oneocr-next:local
ONEOCR_BIND_ADDRESS=127.0.0.1
ONEOCR_PUBLISHED_PORT=8001
ONEOCR_MODEL_PATH=/app/models/oneocr.onemodel
ONEOCR_LAYOUT_MODEL_PATH=/app/models/deepdoc-layout.onnx
ONEOCR_NEEDLE_MODEL_PATH=/app/models/needle3.cact
ONEOCR_THREADS=2
ONEOCR_MAX_PENDING=8
ONEOCR_MAX_BODY_BYTES=20971520
ONEOCR_MAX_PIXELS=40000000
ONEOCR_REQUEST_TIMEOUT_MS=60000
ONEOCR_EXTRACTION_TIMEOUT_MS=15000
ONEOCR_SHUTDOWN_TIMEOUT_MS=65000
ONEOCR_CPUS=2
ONEOCR_MEMORY_LIMIT=2g
